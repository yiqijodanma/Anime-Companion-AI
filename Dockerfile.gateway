# syntax=docker/dockerfile:1.7

# The frontend repository is supplied as the named context "frontend".
# package-lock.json + npm ci make the build deterministic for a given commit.
FROM node:22-alpine AS frontend-builder

ENV NODE_OPTIONS=--max-old-space-size=256

WORKDIR /frontend
COPY --from=frontend package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --from=frontend index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY --from=frontend public ./public
COPY --from=frontend src ./src
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend-builder

ENV GOMAXPROCS=1 \
    GOMEMLIMIT=256MiB

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN rm -rf internal/webui/static && mkdir -p internal/webui/static
COPY --from=frontend-builder /frontend/dist/ ./internal/webui/static/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/gateway ./cmd/gateway
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/seed-admin ./cmd/seed-admin

FROM alpine:3.22

ARG BACKEND_COMMIT=unknown
ARG FRONTEND_COMMIT=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.title="Anime Companion AI Gateway" \
      org.opencontainers.image.revision=$BACKEND_COMMIT \
      org.opencontainers.image.created=$BUILD_TIMESTAMP \
      io.animecompanion.backend.revision=$BACKEND_COMMIT \
      io.animecompanion.frontend.revision=$FRONTEND_COMMIT

RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=backend-builder /out/gateway /app/gateway
COPY --from=backend-builder /out/seed-admin /app/seed-admin

USER 65532:65532
ENTRYPOINT ["/app/gateway"]
