# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS builder

ENV GOMAXPROCS=1 \
    GOMEMLIMIT=256MiB

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/agent ./cmd/agent

FROM alpine:3.22

ARG BACKEND_COMMIT=unknown
ARG BUILD_TIMESTAMP=unknown

LABEL org.opencontainers.image.title="Anime Companion AI Agent" \
      org.opencontainers.image.revision=$BACKEND_COMMIT \
      org.opencontainers.image.created=$BUILD_TIMESTAMP \
      io.animecompanion.backend.revision=$BACKEND_COMMIT

RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /out/agent /app/agent

USER 65532:65532
ENTRYPOINT ["/app/agent"]
